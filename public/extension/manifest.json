{
  "manifest_version": 3,
  "name": "Invitation Homes Property Importer",
  "version": "1.0.0",
  "description": "Extract rental listings directly from Zillow, Realtor.com, Redfin, and web portals into the Invitation Homes staging queue.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.zillow.com/*",
    "https://*.realtor.com/*",
    "https://*.redfin.com/*",
    "https://*.apartments.com/*",
    "https://*.rentprogress.com/*",
    "https://*.invitationhomes.com/*",
    "*://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to Invitation Homes Staging"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zillow.com/*",
        "https://*.realtor.com/*",
        "https://*.redfin.com/*",
        "https://*.apartments.com/*",
        "https://*.rentprogress.com/*",
        "https://*.invitationhomes.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
