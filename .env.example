# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Map tiles. The default OpenStreetMap tiles are keyless and free, so no API key
# or billing account is required. Override these only if you use a different
# free tile provider; you never need a paid or premium map service.
# VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# VITE_MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# Supabase public browser configuration. RLS must protect every exposed table.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only application intake and transactional email configuration.
# Never prefix these with VITE_ and never commit real values.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
APPS_SCRIPT_WEB_APP_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
APPS_SCRIPT_SHARED_SECRET="GENERATE_THE_SAME_LONG_RANDOM_SECRET_IN_APPS_SCRIPT_PROPERTIES"
APPLICATION_SUPPORT_EMAIL="verified-support@example.com"
APPLICATION_REVIEW_EMAIL="leasing-review@example.com"
APPLICATION_BASE_URL="https://your-application-domain.example"
APPLICATION_RATE_LIMIT_SECRET="GENERATE_A_LONG_RANDOM_SERVER_SECRET"
APPLICATION_DISPATCH_SECRET="GENERATE_A_SEPARATE_LONG_RANDOM_SERVER_SECRET"

# Optional ImageKit remote-origin delivery. Configure the official image host as an ImageKit origin.
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/YOUR_IMAGEKIT_ID"
VITE_IMAGEKIT_SOURCE_ORIGIN="https://images.invitationhomes.com"
